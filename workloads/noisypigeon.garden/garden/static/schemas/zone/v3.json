{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noisypigeon.garden/schemas/zone/v3.json",
  "title": "Zone zone.yaml (LIB-0036, LIB-0037, LIB-0038, LIB-0039)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "zone"
  ],
  "properties": {
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suffix"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "The zone unit's name, and its Scaleway project's. Default: the zone apex, its directory (LIB-0036 §1)"
        },
        "prefix": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "What every other resource's name starts with. Default: name, with each character outside a-z, 0-9 and - as a dash (LIB-0036 §1)"
        },
        "suffix": {
          "type": "string",
          "minLength": 1
        },
        "hosts": {
          "type": [
            "object",
            "null"
          ],
          "propertyNames": {
            "pattern": "^(@|[a-z0-9]([a-z0-9-]*[a-z0-9])?)$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "description": "Who serves the apex (@) and each subdomain label: a workload under workloads/<zone>/, which writes records only at its host (LIB-0037 §3)"
        },
