                                  "const": "0"
                                }
                              },
                              "required": [
                                "version"
                              ]
                            },
                            "then": {
                              "$ref": "https://noisypigeon.garden/terraform/cloudflare/ruleset/v0.2.0/workload.schema.json"
                            }
                          },
