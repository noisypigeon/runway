                ]
              }
            },
            "apexRedirect": {
              "type": [
                "object",
                "null"
              ],
              "propertyNames": {
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "description": "A redirect of the apex, and by default www, to one URL. Each <key> implies dnsRecords.<key>-apex and <key>-www, the proxied placeholders, and cloudflare.ruleset.<key>, the redirect; an entry of the same key overrides field by field (LIB-0038 §3)",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "target_url"
                ],
                "properties": {
                  "target_url": {
                    "type": "string",
                    "pattern": "^https?://[^/]+",
                    "description": "URL every redirected request goes to. The path is not preserved"
                  },
                  "status_code": {
                    "type": "integer",
                    "enum": [
                      301,
                      302,
                      303,
                      307,
                      308
                    ],
                    "description": "Default: 301"
                  },
                  "include_www": {
                    "type": "boolean",
                    "description": "Whether www is redirected too. Default: true"
                  },
                  "preserve_query_string": {
                    "type": "boolean",
                    "description": "Whether the query string is appended to target_url. Default: false"
                  }
                }
              }
            }
          }
        },
        "services": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "description": "Mail and identity providers. Each enabled one implies its records in dnsRecords, keyed <service>-<record>, which an entry of the same key overrides field by field. proton and fastmail are never both enabled (LIB-0039 §3)",
          "properties": {
            "proton": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "description": "Proton Pass aliases: MX, DKIM, SPF, DMARC and the two verification records",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Whether its records are implied. Default: false"
                },
                "verification": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "pm",
                    "protonmail"
                  ],
                  "properties": {
                    "pm": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The pm-verification= value"
                    },
                    "protonmail": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The protonmail-verification= value"
                    }
                  }
                },
                "dmarc": {
                  "type": [
                    "boolean",
                    "string"
                  ],
                  "pattern": "^v=DMARC1;",
                  "description": "true (the default) implies the policy v=DMARC1; p=quarantine; pct=100; adkim=s; aspf=s at _dmarc, a string implies that policy instead, and false implies none (LIB-0039 §3)"
                }
              },
              "if": {
                "required": [
                  "enabled"
                ],
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              },
              "then": {
                "required": [
                  "verification"
                ]
              }
            },
            "fastmail": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "description": "Fastmail: MX, DKIM, SPF and DMARC",
              "properties": {
