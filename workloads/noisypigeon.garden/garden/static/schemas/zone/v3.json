        },
        "cloudflare": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "deployer": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "version": {
                      "type": "string",
                      "enum": [
                        "0",
                        "0.1",
                        "0.1.0"
                      ]
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "not": {
                          "required": [
                            "version"
                          ]
                        }
                      },
                      "then": {
                        "$ref": "https://noisypigeon.garden/terraform/cloudflare/api-token/v0.1.0/workload.schema.json"
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "version": {
                            "const": "0"
                          }
                        },
                        "required": [
                          "version"
                        ]
                      },
                      "then": {
                        "$ref": "https://noisypigeon.garden/terraform/cloudflare/api-token/v0.1.0/workload.schema.json"
                      }
