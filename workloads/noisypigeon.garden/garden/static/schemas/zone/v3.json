                            "const": "0.1.0"
                          }
                        },
                        "required": [
                          "version"
                        ]
                      },
                      "then": {
                        "$ref": "https://noisypigeon.garden/terraform/cloudflare/api-token/v0.1.0/workload.schema.json"
                      }
                    }
                  ]
                }
              ]
            },
            "ruleset": {
              "type": [
                "object",
                "null"
              ],
              "propertyNames": {
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "additionalProperties": {
                "allOf": [
                  {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "version": {
                            "type": "string",
                            "enum": [
                              "0",
                              "0.1",
                              "0.1.0",
                              "0.2",
                              "0.2.0"
                            ]
                          }
                        },
                        "allOf": [
                          {
                            "if": {
                              "not": {
                                "required": [
                                  "version"
                                ]
                              }
                            },
                            "then": {
                              "$ref": "https://noisypigeon.garden/terraform/cloudflare/ruleset/v0.2.0/workload.schema.json"
                            }
                          },
                          {
