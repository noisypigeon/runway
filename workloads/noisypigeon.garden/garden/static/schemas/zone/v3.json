                          }
                        },
                        {
                          "if": {
                            "properties": {
                              "version": {
                                "const": "4.0"
                              }
                            },
                            "required": [
                              "version"
                            ]
                          },
                          "then": {
                            "$ref": "https://noisypigeon.garden/terraform/scaleway/iam-policy/v4.0.0/inputs.schema.json"
                          }
