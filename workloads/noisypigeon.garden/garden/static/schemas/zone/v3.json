                  "enabled"
                ],
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              },
              "then": {
                "required": [
                  "verification"
                ]
              }
            },
            "bluesky": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "description": "A Bluesky handle at the zone apex",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Whether its records are implied. Default: false"
                },
                "did": {
                  "type": "string",
                  "pattern": "^did:",
                  "description": "The account DID, served at _atproto"
                }
              },
              "if": {
                "required": [
                  "enabled"
                ],
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              },
              "then": {
                "required": [
                  "did"
                ]
              }
            }
          }
        },
        "dnsRecords": {
