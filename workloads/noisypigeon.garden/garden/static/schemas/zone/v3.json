                                "version": {
                                  "const": "0.1"
                                }
                              },
                              "required": [
                                "version"
                              ]
                            },
                            "then": {
                              "$ref": "https://noisypigeon.garden/terraform/cloudflare/ruleset/v0.1.0/workload.schema.json"
                            }
                          },
                          {
                            "if": {
                              "properties": {
                                "version": {
                                  "const": "0.1.0"
                                }
                              },
                              "required": [
                                "version"
                              ]
                            },
                            "then": {
