                    {
                      "if": {
                        "not": {
                          "required": [
                            "version"
                          ]
                        }
                      },
                      "then": {
                        "$ref": "https://noisypigeon.garden/terraform/scaleway/project/v2.0.3/inputs.schema.json"
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "version": {
                            "const": "2"
                          }
                        },
                        "required": [
                          "version"
                        ]
                      },
                      "then": {
                        "$ref": "https://noisypigeon.garden/terraform/scaleway/project/v2.0.3/inputs.schema.json"
                      }
                    },
                    {
