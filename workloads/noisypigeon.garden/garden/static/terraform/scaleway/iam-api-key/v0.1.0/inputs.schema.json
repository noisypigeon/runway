{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+){0,2}$",
      "description": "Pins this module: X.Y.Z exactly, X.Y or X to the newest release within it. Omitted, the newest release (LIB-0023 §3)."
    },
    "application_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "IAM application ID this key authenticates as"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "IAM API key description"
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "API key expiration timestamp (i.e. 2027-09-25T22:32:12Z). Defaults to 30 days after the key is first created."
    }
  },
  "$id": "https://noisypigeon.garden/terraform/scaleway/iam-api-key/v0.1.0/inputs.schema.json"
}
