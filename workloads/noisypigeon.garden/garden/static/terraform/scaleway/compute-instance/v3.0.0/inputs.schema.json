{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+){0,2}$",
      "description": "Pins this module: X.Y.Z exactly, X.Y or X to the newest release within it. Omitted, the newest release (LIB-0023 §3)."
    },
    "additional_volume_ids": {
      "anyOf": [
        {
          "type": "array",
          "default": []
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "IDs of pre-created block volumes (e.g. scaleway/block-volume's id output) to attach to the instance"
    },
    "buckets": {
      "anyOf": [
        {
          "type": "array",
          "default": []
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "Buckets to configure in rclone; only used when profile = \"pigeon-cli\""
    },
    "cockpit": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "Scaleway Cockpit wiring for an on-host Grafana Alloy agent that tails pigeon-cli's JSONL log and scrapes its Prometheus metrics endpoint (ADR-0102); only used when profile = \"pigeon-cli\". null disables Alloy entirely."
    },
    "enable_ipv4": {
      "anyOf": [
        {
          "type": "boolean",
          "default": true
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "Create and attach a routed IPv4 address (true/false)"
    },
    "enable_ipv6": {
      "anyOf": [
        {
          "type": "boolean",
          "default": false
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "Create and attach a routed IPv6 address (true/false)"
    },
    "environment_variables": {
      "anyOf": [
        {
          "type": "object",
          "default": {}
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "Key/value environment variables exported on the instance for any profile (e.g. pigeon-cli secrets, by convention named PIGEON_SECRET_<ALIAS> but not enforced by this module)"
    },
    "image": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "Instance image (UUID or marketplace label)"
    },
    "keyring_entries": {
      "anyOf": [
        {
          "type": "array",
          "default": []
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "pigeon-cli keyring.toml entries; only used when profile = \"pigeon-cli\""
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "Instance name suffix"
    },
    "namespace": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "Instance name prefix"
    },
    "profile": {
      "anyOf": [
        {
          "type": "string",
          "default": "pigeon-cli"
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "Cloud-init provisioning profile: \"docker\" (Docker CE), or \"pigeon-cli\" (rclone/neovim + rclone.conf from buckets, plus runs the pigeon-cli bootstrap script directly on first boot)"
    },
    "ssh_keys": {
      "anyOf": [
        {
          "type": "array",
          "default": []
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "SSH public keys granted instance-specific access via Scaleway's AUTHORIZED_KEY tag convention, in addition to account-wide keys"
    },
    "type": {
      "anyOf": [
        {
          "type": "string",
          "default": "STARDUST1-S"
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "Instance commercial type"
    }
  },
  "$id": "https://noisypigeon.garden/terraform/scaleway/compute-instance/v3.0.0/inputs.schema.json"
}
