{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+){0,2}$",
      "description": "Pins this module: X.Y.Z exactly, X.Y or X to the newest release within it. Omitted, the newest release (LIB-0023 §3)."
    },
    "gateway_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "ID of the Public Gateway whose IP the rule listens on"
    },
    "private_ip": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "The target's IPv4 address on the gateway's Private Network"
    },
    "private_port": {
      "anyOf": [
        {
          "type": "number",
          "default": 22
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "Port on the target"
    },
    "protocol": {
      "anyOf": [
        {
          "type": "string",
          "default": "tcp"
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "tcp, udp or both"
    },
    "public_port": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "Port on the gateway's public IP"
    }
  },
  "$id": "https://noisypigeon.garden/terraform/scaleway/gateway-pat-rule/v0.1.0/inputs.schema.json"
}
