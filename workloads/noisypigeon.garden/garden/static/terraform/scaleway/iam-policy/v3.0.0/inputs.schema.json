{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+){0,2}$",
      "description": "Pins this module: X.Y.Z exactly, X.Y or X to the newest release within it. Omitted, the newest release (LIB-0023 §3)."
    },
    "admin_project_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "Project id that should always retain full access to bucket_names, even if excluded from the narrow bucket_names/bucket_actions grant (prevents the applying/deployer identity from locking itself out of a bucket policy it just created)"
    },
    "bucket_actions": {
      "anyOf": [
        {
          "type": "array",
          "default": []
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "S3 actions granted on each bucket in bucket_names (no actions are granted by default)"
    },
    "bucket_names": {
      "anyOf": [
        {
          "type": "object",
          "default": {}
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "Map of static logical key => exact Object Storage bucket name to grant access to (no bucket access is granted by default)"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "IAM application/policy description"
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "API key expiration timestamp (i.e. 2027-09-25T22:32:12Z)"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "IAM application/policy name"
    },
    "organization_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "Organization id"
    },
    "organization_permission_sets": {
      "anyOf": [
        {
          "type": "array"
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "Organization permission set grants"
    },
    "project_ids": {
      "anyOf": [
        {
          "type": "array"
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "Project ids"
    },
    "project_permission_sets": {
      "anyOf": [
        {
          "type": "array"
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "Project permission set grants"
    }
  },
  "$id": "https://noisypigeon.garden/terraform/scaleway/iam-policy/v3.0.0/inputs.schema.json"
}
