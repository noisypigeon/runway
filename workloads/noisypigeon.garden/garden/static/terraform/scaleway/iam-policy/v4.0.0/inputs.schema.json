            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "IAM application ID this policy is attached to"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
      ],
      "description": "IAM policy description"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "secretRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "description": "A name in the workload secrets.yaml env map (LIB-0025)"
            }
          }
        }
