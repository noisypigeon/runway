.DS_Store
*.env
/.config/src/
.terragrunt-cache/
.terraform/
.terraform.lock.hcl
*.tfstate*
# Workload stubs are generated from values.yaml, never committed (LIB-0023),
# under their provider's directory; a site workload's own files sit beside
# them, so only these are ignored (LIB-0031 §2).
/workloads/*/scaleway/
/workloads/*/backblaze/
/workloads/*/cloudflare/
/workloads/*/themes/
/workloads/*/public/
# A workload in its zone (LIB-0037), the same way: by provider, never
# /workloads/*/*/*/, which would hide its site files.
/workloads/*/*/scaleway/
/workloads/*/*/backblaze/
/workloads/*/*/cloudflare/
/workloads/*/*/themes/
/workloads/*/*/public/
# A zone's stubs, the same way, from its zone.yaml (LIB-0036).
/zones/*/scaleway/
/zones/*/cloudflare/
